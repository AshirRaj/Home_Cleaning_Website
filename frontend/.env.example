# Frontend Public Configuration
# Only public frontend configuration belongs here. Never put private API keys or secrets in VITE_* variables.

# Your deployed Backend API URL (e.g. on Render, Railway, VPS)
# You can set either VITE_API_URL or VITE_API_BASE_URL.
# Example: https://your-backend-api.onrender.com/api
VITE_API_URL=https://your-backend-api.onrender.com/api
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api

# Razorpay Key ID (Public key: starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_sparkle123
